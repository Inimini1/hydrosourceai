# Port the API server listens on
PORT=4000

# Hardcoded admin password for the MVP admin panel (no auth library)
ADMIN_PASSWORD=changeme123

# Secret used to sign admin session tokens (JWT). Change this in production.
JWT_SECRET=autoedge-dev-secret-change-me

# Comma-separated list of allowed origins for CORS (the client dev/prod URL)
CLIENT_ORIGIN=http://localhost:5173
